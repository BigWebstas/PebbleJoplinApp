# Port the bridge HTTP server listens on
PORT=8077

# Shared secret the Pebble phone companion must send as "Authorization: Bearer <token>"
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRIDGE_TOKEN=changeme

# Directory of the Joplin CLI profile that is already configured to sync with your
# Joplin Server (see ../docs/SETUP.md). This is the --profile dir you pass to `joplin`,
# e.g. the default is ~/.config/joplin
JOPLIN_PROFILE_DIR=/home/pi/.config/joplin-bridge

# Path/command used to invoke the Joplin CLI. Usually just "joplin" if installed globally
# via `npm install -g joplin`, or an absolute path if it's not on PATH for this process.
JOPLIN_BIN=joplin

# How often the bridge runs `joplin sync` in the background, in minutes.
# Set to 0 to disable automatic background sync (you can still POST /api/sync manually).
SYNC_INTERVAL_MINUTES=15

# Timeout for a single `joplin sync` invocation, in milliseconds.
SYNC_TIMEOUT_MS=120000
